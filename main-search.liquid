<section class="page-width"><h1>Search</h1><form action="{{ routes.search_url }}"><input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products"><button>Search</button></form>{% if search.performed %}<div class="product-grid">{% for item in search.results %}<article><a href="{{ item.url }}">{{ item.title | escape }}</a></article>{% else %}<p>No results found.</p>{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}