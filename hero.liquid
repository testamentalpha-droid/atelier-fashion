<section class="hero-section">
  <div class="hero-section__copy">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.heading | escape }}</h1>
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}
  </div>
</section>
{% schema %}
{"name":"Atelier hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE NEW SEASON"},{"type":"text","id":"heading","label":"Heading","default":"Dress like you mean it."},{"type":"richtext","id":"text","label":"Text","default":"<p>Thoughtful pieces. Modern silhouettes. Made to move with you.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Atelier hero"}]}
{% endschema %}