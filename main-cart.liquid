<section class="page-width"><h1>Your bag</h1>{% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post"><ul>{% for item in cart.items %}<li>{{ item.image | image_url: width: 120 | image_tag: alt: item.title }} <a href="{{ item.url }}">{{ item.product.title | escape }}</a> — {{ item.final_line_price | money }} <label>Qty <input type="number" name="updates[]" value="{{ item.quantity }}" min="0"></label></li>{% endfor %}</ul><p>Subtotal: {{ cart.total_price | money }}</p><button type="submit" name="update">Update bag</button><button type="submit" name="checkout">Checkout</button></form>{% else %}<p>Your bag is currently empty.</p><a href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}