<section class="page-width"><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}<div class="product-grid">{% for product in collection.products %}<article><a href="{{ product.url }}">{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.featured_image.alt }}<h2>{{ product.title | escape }}</h2></a><p>{{ product.price | money }}</p></article>{% else %}<p>No products found in this collection.</p>{% endfor %}</div></section>
{% schema %}{"name":"Main collection","settings":[]}{% endschema %}